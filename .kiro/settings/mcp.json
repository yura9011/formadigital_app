{
  "mcpServers": {
    "prospecting": {
      "command": "npx",
      "args": ["tsx", "tools/prospecting-mcp/src/index.ts"],
      "env": {
        "PROSPECT_API_URL": "http://localhost:3000/api/prospect"
      },
      "disabled": false,
      "autoApprove": [
        "search_businesses",
        "check_harv3st_status",
        "get_leads",
        "get_lead_detail",
        "get_contact_history",
        "get_contact_stats",
        "get_templates",
        "get_user_config",
        "validate_contact_data",
        "create_contact_record",
        "update_contact_status",
        "enrich_contact",
        "set_user_config"
      ]
    }
  }
}
