generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id            String      @id @default(uuid())
  content       String
  publishDate   DateTime
  state         PostState   @default(QUEUE)
  integrationId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  errorLog      String?
  media         Json?
  integration   Integration @relation(fields: [integrationId], references: [id])
}

model Integration {
  id              String    @id @default(uuid())
  name            String
  provider        String
  token           String
  refreshToken    String?
  tokenExpiration DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accountId       String?
  pictureUrl      String?
  posts           Post[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GmbSearch {
  id        String   @id @default(uuid())
  query     String
  location  String
  radius    Float
  results   Json
  createdAt DateTime @default(now())
}

model GmbAudit {
  id              String   @id @default(uuid())
  businessName    String
  businessAddress String
  auditData       Json
  createdAt       DateTime @default(now())
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
}

model Client {
  id            String     @id @default(uuid())
  name          String
  address       String
  phone         String?
  website       String?
  category      String?
  rating        Float?
  reviewCount   Int?
  latitude      Float?
  longitude     Float?
  googleMapsUri String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  audits        GmbAudit[]
  notes         ClientNote[]
  projects      Project[]
  type          ClientType @default(LEAD)

  @@unique([name, address])
}

model Project {
  id          String         @id @default(uuid())
  name        String
  status      ProjectStatus  @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  actualCost  Float?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phases      ProjectPhase[]
}

model ProjectPhase {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  status      PhaseStatus   @default(PENDING)
  order       Int
  startDate   DateTime?
  endDate     DateTime?
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments PhaseAttachment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PhaseAttachment {
  id        String   @id @default(uuid())
  type      AttachmentType
  filePath  String
  fileName  String
  phaseId   String
  phase     ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProjectTemplate {
  id        String   @id @default(uuid())
  name      String
  description String?
  phases    Json     // Stores array of phase names/descriptions
  createdAt DateTime @default(now())
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  DONE
}

enum AttachmentType {
  IMAGE
  AUDIO
  FILE
}

model ClientNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ClientType {
  CLIENT
  LEAD
  COMPETITOR
}

enum PostState {
  QUEUE
  PUBLISHED
  ERROR
  DRAFT
}
