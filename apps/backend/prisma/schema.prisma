generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id            String      @id @default(uuid())
  content       String
  publishDate   DateTime
  state         PostState   @default(QUEUE)
  integrationId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  errorLog      String?
  media         Json?
  integration   Integration @relation(fields: [integrationId], references: [id])
}

model Integration {
  id              String    @id @default(uuid())
  name            String
  provider        String
  token           String
  refreshToken    String?
  tokenExpiration DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accountId       String?
  pictureUrl      String?
  posts           Post[]
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  googleCredential GoogleCredential?
  gbpLocations     GbpLocation[]
  gscProperties    GscProperty[]
  reminders        Reminder[]
  assignedProjects Project[]         @relation("ProjectAssignee")
  
  // Prospecting relations
  contactRecords   ContactRecord[]
  messageTemplates MessageTemplate[]
  prospectConfig   ProspectConfig?
}

// Google OAuth credentials for GBP/GSC API access
model GoogleCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  accessToken  String   @db.Text // Encrypted
  refreshToken String   @db.Text // Encrypted
  expiresAt    DateTime
  scopes       String[]
  accountEmail String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Google Business Profile locations
model GbpLocation {
  id          String   @id @default(uuid())
  accountId   String   // Google GBP account ID
  locationId  String   // Google location ID
  name        String
  address     String
  phone       String?
  rating      Float?
  reviewCount Int?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, locationId])
}

// Google Search Console properties
model GscProperty {
  id              String   @id @default(uuid())
  siteUrl         String   // e.g., "sc-domain:example.com"
  permissionLevel String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([siteUrl, userId])
}

model GmbSearch {
  id        String   @id @default(uuid())
  query     String
  location  String
  radius    Float
  results   Json
  createdAt DateTime @default(now())
}

model GmbAudit {
  id              String   @id @default(uuid())
  businessName    String
  businessAddress String
  auditData       Json
  createdAt       DateTime @default(now())
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
}

model Client {
  id            String     @id @default(uuid())
  name          String
  address       String
  phone         String?
  website       String?
  category      String?
  rating        Float?
  reviewCount   Int?
  latitude      Float?
  longitude     Float?
  googleMapsUri String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  audits        GmbAudit[]
  notes         ClientNote[]
  projects      Project[]
  reminders     Reminder[]
  type          ClientType @default(LEAD)

  // === Pipeline Fields ===
  stage           PipelineStage @default(DISCOVERED)
  discardedAt     DateTime?
  convertedAt     DateTime?
  revivedAt       DateTime?
  discardReason   String?

  // === Extended GMB Fields ===
  photoCount      Int?
  hours           Json?
  attributes      Json?
  priceLevel      Int?
  reviewsUrl      String?

  // === Enrichment Fields (Agent System) ===
  email         String?
  instagram     String?
  facebook      String?
  linkedin      String?
  
  // === Instagram Enrichment Fields ===
  instagramFollowers    Int?
  instagramPosts        Int?
  instagramLastPostDate DateTime?
  instagramBio          String?
  
  // Scoring & Classification
  tier          String?          // HOT, WARM, COLD
  score         Int?             // 0-100 opportunity score
  gaps          Json?            // ["No Website", "Low Reviews", etc.]
  
  // LLM Analysis
  summary       String?   @db.Text  // AI-generated business summary
  enrichedAt    DateTime?           // Last enrichment timestamp
  source        String?             // "SerpApi", "Manual", "Playwright"
  placeId       String?   @unique   // Google Place ID for deduplication

  // === Prospecting Fields ===
  contactStatus   String?   @default("none")  // none, pending, approved, sent, rejected, responded
  lastContactedAt DateTime?                   // Last time this client was contacted

  // === Prospecting v2.0 Fields ===
  contactAttempts   Int       @default(0)    // Counter for contact attempts (max 10)
  snoozedUntil      DateTime?                // Skip until this date
  snoozeReason      String?                  // Why snoozed (e.g. "Dijo contactar en 3 meses")
  hasValidWhatsapp  Boolean   @default(false) // Phone is valid for WhatsApp
  hasValidInstagram Boolean   @default(false) // Has Instagram handle
  hasValidEmail     Boolean   @default(false) // Has email address

  // Relations for prospecting
  contacts        ContactRecord[]
  transitions     StageTransition[]

  @@unique([name, address])
  @@index([stage])
  @@index([score])
}

model Project {
  id           String         @id @default(uuid())
  name         String
  status       ProjectStatus  @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  budget       Float?
  actualCost   Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phases       ProjectPhase[]
  assignedToId String?
  assignedTo   User?          @relation("ProjectAssignee", fields: [assignedToId], references: [id])
  reminders    Reminder[]
}

model ProjectPhase {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  status      PhaseStatus   @default(PENDING)
  order       Int
  startDate   DateTime?
  endDate     DateTime?
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments PhaseAttachment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PhaseAttachment {
  id        String   @id @default(uuid())
  type      AttachmentType
  filePath  String
  fileName  String
  phaseId   String
  phase     ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProjectTemplate {
  id        String   @id @default(uuid())
  name      String
  description String?
  phases    Json     // Stores array of phase names/descriptions
  createdAt DateTime @default(now())
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  DONE
}

enum AttachmentType {
  IMAGE
  AUDIO
  FILE
}

model ClientNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ClientType {
  CLIENT
  LEAD
  COMPETITOR
}

enum PipelineStage {
  DISCOVERED   // Recién encontrado/importado
  ANALYZED     // Analizado con score y gaps
  CONTACTED    // Se envió al menos un mensaje
  RESPONDED    // El lead respondió
  CONVERTED    // Se convirtió en cliente
  DISCARDED    // Descartado (no interesa)
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

enum PostState {
  QUEUE
  PUBLISHED
  ERROR
  DRAFT
}

// Reminder/Alert system
model Reminder {
  id          String         @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime       // When the reminder should trigger
  status      ReminderStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  // Relations
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ReminderStatus {
  PENDING     // Future - not yet due
  ACTIVE      // Due date reached
  COMPLETED   // Marked as done
  DISMISSED   // Ignored/cancelled
}

// === PROSPECTING MODELS ===

// Contact Record - registro de cada intento de contacto
model ContactRecord {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel     String    // instagram, whatsapp, email
  message     String    @db.Text
  status      String    @default("pending") // pending, approved, sent, rejected, responded
  notes       String?   @db.Text
  sentAt      DateTime?
  respondedAt DateTime?
  
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([clientId])
  @@index([status])
  @@index([userId])
}

// Message Template - plantillas de mensaje para prospección
model MessageTemplate {
  id          String    @id @default(uuid())
  name        String
  channel     String    // instagram, whatsapp, email
  scenario    String    // sin_sitio, rating_bajo, sin_fotos, sin_redes, general
  content     String    @db.Text
  isDefault   Boolean   @default(false)
  
  userId      String?   // null = global template available to all users
  user        User?     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([channel])
  @@index([scenario])
  @@index([userId])
}

// Prospect Config - configuración de prospección por usuario
model ProspectConfig {
  id                    String  @id @default(uuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  userName              String?
  companyName           String?
  defaultChannel        String  @default("instagram") // instagram, whatsapp, email
  maxContactsPerSession Int     @default(10)
  signature             String? @db.Text
  
  // Social handles for outreach
  instagramHandle       String?
  whatsappNumber        String?
  emailAddress          String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


// === PIPELINE MODELS ===

// Stage Transition - historial de cambios de etapa en el pipeline
model StageTransition {
  id          String        @id @default(uuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage
  toStage     PipelineStage
  reason      String?
  actorType   ActorType
  actorId     String?       // userId if USER, agentName if AGENT, null if SYSTEM
  createdAt   DateTime      @default(now())
  
  @@index([clientId])
  @@index([createdAt])
}
